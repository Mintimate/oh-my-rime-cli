{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Oh My Rime",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Rust CLI",
      "type": "cargo",
      "request": "launch",
      "cargo": { "args": ["run", "--bin", "oh-my-rime-cli"], "filter": { "name": "oh-my-rime-cli", "kind": "bin" } }
    }
  ]
}
